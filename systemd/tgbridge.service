[Unit]
Description=tgbridge - minimal Telegram bridge for a local CLI agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
# simple keeps startup independent of Telegram reachability; heartbeats begin
# immediately and follow main-loop progress, including failed network attempts.
Type=simple
NotifyAccess=main
WatchdogSec=300
WatchdogSignal=SIGKILL
TimeoutStopSec=20
KillMode=control-group
ExecStart=/usr/bin/python3 %h/dev/tgbridge/tgbridge.py
UMask=0077
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
